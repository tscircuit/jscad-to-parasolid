{
  "name": "jscad-to-parasolid",
  "version": "0.0.4",
  "description": "Convert JSCAD and modelprinter geometry to Parasolid text files",
  "type": "module",
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tscircuit/jscad-to-parasolid.git"
  },
  "license": "MIT",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test:unit": "bun test tests/unit",
    "test:visual": "bun test tests/visual",
    "test:update-snapshots": "BUN_UPDATE_SNAPSHOTS=1 bun test tests/visual",
    "build": "tsup lib/index.ts --format esm --dts --clean",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3",
    "jscad-electronics": "https://pkg.pr.new/tscircuit/jscad-electronics@05b82f6930ae5e00ea04c67ca01164b1b73d8665",
    "poppygl": "0.0.30",
    "looks-same": "10.0.1",
    "tsup": "8.5.0"
  },
  "dependencies": {
    "@jscad/modeling": "^2.12.6",
    "jscad-planner": "^0.0.18",
    "parasolidts": "^0.0.2 || ^0.0.3"
  },
  "patchedDependencies": {
    "poppygl@0.0.30": "patches/poppygl@0.0.30.patch"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
