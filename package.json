{
  "name": "jscad-to-parasolid",
  "version": "0.0.1",
  "description": "Convert JSCAD and modelprinter geometry to Parasolid text files",
  "type": "module",
  "module": "lib/index.ts",
  "main": "lib/index.ts",
  "types": "lib/index.ts",
  "exports": {
    ".": "./lib/index.ts"
  },
  "files": [
    "lib"
  ],
  "repository": "https://github.com/tscircuit/jscad-to-parasolid",
  "license": "MIT",
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test:unit": "bun test tests/unit",
    "test:visual": "bun test tests/visual",
    "test:update-snapshots": "BUN_UPDATE_SNAPSHOTS=1 bun test tests/visual"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.14",
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3",
    "jscad-electronics": "0.0.186",
    "poppygl": "0.0.30",
    "looks-same": "10.0.1"
  },
  "dependencies": {
    "@jscad/modeling": "^2.12.6",
    "jscad-planner": "^0.0.18",
    "parasolidts": "github:tscircuit/parasolidts#a9a3ce6847919cd3911f97d24e796a307fa15e10"
  },
  "patchedDependencies": {
    "poppygl@0.0.30": "patches/poppygl@0.0.30.patch"
  }
}
